# Application settings (all optional; defaults shown). Copy to .env for local runs.
VAULTDROP_DATABASE_URL=sqlite:///./vaultdrop.db
VAULTDROP_AWS_REGION=us-east-1
VAULTDROP_S3_BUCKET=replace-me
VAULTDROP_S3_ENDPOINT=
VAULTDROP_S3_PUBLIC_ENDPOINT=
VAULTDROP_S3_PATH_STYLE=false
VAULTDROP_S3_BOOTSTRAP=false
VAULTDROP_S3_SSE=aws:kms
VAULTDROP_S3_KMS_KEY_ID=
VAULTDROP_DEFAULT_QUOTA_BYTES=1073741824
VAULTDROP_ALLOWED_ORIGINS=http://localhost:8000
VAULTDROP_COOKIE_SECURE=true

# docker compose only: run scripts/dev-env.sh to generate these locally.
POSTGRES_PASSWORD=replace-me
GARAGE_RPC_SECRET=replace-me
GARAGE_ADMIN_TOKEN=replace-me
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
